# PostgreSQL connection string
DATABASE_URL=postgres://localdesk:localdesk@localhost:5432/localdesk
# Random secret (>= 32 chars) used to sign session cookies. Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Public URL of the app (used in booking links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Session cookie `Secure` flag. Leave unset (auto): Secure when NEXT_PUBLIC_APP_URL is https:// or the
# proxy sends X-Forwarded-Proto: https; plain-HTTP local/LAN testing gets a non-Secure cookie.
# Set to "true" to force Secure (recommended in production), "false" to force it off.
# AUTH_COOKIE_SECURE=
