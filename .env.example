# PostgreSQL connection string
DATABASE_URL=postgres://localdesk:localdesk@localhost:5432/localdesk
# Random secret (>= 32 chars) used to sign session cookies. Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Public URL of the app (used in booking links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Session cookie `Secure` flag. Leave unset (auto): Secure when NEXT_PUBLIC_APP_URL is https:// or the
# proxy sends X-Forwarded-Proto: https; plain-HTTP local/LAN testing gets a non-Secure cookie.
# Set to "true" to force Secure (recommended in production), "false" to force it off.
# AUTH_COOKIE_SECURE=

# ---- Social sign-in (optional). A provider's button only appears when ALL of its variables are set. ----
# Redirect URIs are derived from NEXT_PUBLIC_APP_URL:  <APP_URL>/api/auth/google/callback  and  <APP_URL>/api/auth/apple/callback
# Setup guide: docs/OAUTH_SETUP.md   ·   Check status: npm run oauth:status
# Google (works on http://localhost or any https:// domain)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple (requires an https:// NEXT_PUBLIC_APP_URL on a verified domain — localhost / IPs are rejected by Apple)
APPLE_CLIENT_ID=            # the *Services ID*, e.g. com.example.localdesk.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=          # contents of the AuthKey_XXXX.p8 file; newlines may be written as \n
